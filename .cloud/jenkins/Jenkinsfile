// Runs `script` in the pinned Go toolchain instead of whatever the agent host
// has. Keep the image in sync with .cloud/docker/Dockerfile and go.mod
// (go 1.27.1). Plain `docker run` rather than `agent { docker }`, which needs
// the Docker Pipeline plugin (up for adoption, deliberately not used). The
// container runs as the Jenkins uid; HOME and the Go caches live in the
// workspace's @tmp sibling. GOWORK=off matches the image build, which deletes
// go.work: deps come from go.mod, so this passes once scripts/release-all.sh
// has bumped them to the released utility versions.
def inGo(String script) {
    withEnv(["CI_SCRIPT=${script}"]) {
        sh '''
            mkdir -p "$WORKSPACE@tmp/ci-home"
            docker run --rm -u "$(id -u):$(id -g)" \\
                -v "$WORKSPACE:$WORKSPACE" -v "$WORKSPACE@tmp:$WORKSPACE@tmp" -w "$WORKSPACE" \\
                -e HOME="$WORKSPACE@tmp/ci-home" \\
                -e GOCACHE="$WORKSPACE@tmp/go-build" \\
                -e GOMODCACHE="$WORKSPACE@tmp/go-mod" \\
                -e GOTOOLCHAIN=local -e GOWORK=off -e GOPRIVATE='github.com/CodeClarityCE/*' \\
                golang:1.27.1@sha256:3680233e3204827fbdc66088528ae6d4b3d034f51d03a99d454f6de034888244 \\
                sh -ec "$CI_SCRIPT"
        '''
    }
}

pipeline {
    agent { label 'codeclarity' }

    options {
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Setup') {
            steps {
                script {
                    def project = readJSON file: 'config.json'
                    env.Version = project.version                       // e.g. v0.0.15-alpha
                    env.ImageName = project.image_name                  // e.g. codeclarityce/plugin-js-sbom
                    env.Tag = "${ImageName}:${Version.substring(1)}"    // Docker tag drops the 'v'
                    // One buildx builder per image: a shared name let concurrent
                    // jobs on the agent reuse or remove each other's builder.
                    env.Builder = "builder-${ImageName.tokenize('/').last()}"
                    echo "Version: ${Version}, Tag: ${Tag}"
                }
                sh 'git submodule update --init --recursive'
                sh 'git fetch --tags --force origin'
            }
        }

        stage('PR Version Check') {
            when {
                expression { env.CHANGE_TARGET == 'main' }
            }
            steps {
                script {
                    // No `|| true`: if main can't be fetched the check must fail,
                    // not compare against an empty version and pass.
                    sh 'git fetch --force origin main:refs/remotes/origin/main'
                    if (sh(script: 'git cat-file -e origin/main:config.json', returnStatus: true) != 0) {
                        echo 'No config.json on main yet, skipping version check'
                        return
                    }
                    def mainVersion = readJSON(text: sh(script: 'git show origin/main:config.json', returnStdout: true)).version
                    def highest = sh(
                        script: "printf '%s\\n%s\\n' '${mainVersion}' '${Version}' | sort -V | tail -n1",
                        returnStdout: true
                    ).trim()

                    echo "PR Version: ${Version}"
                    echo "Main Version: ${mainVersion}"

                    if (Version == mainVersion || highest != Version) {
                        error "Version not bumped! PR version (${Version}) must be greater than main version (${mainVersion}). Please update config.json version."
                    }
                    echo "Version check passed: ${mainVersion} -> ${Version}"
                }
            }
        }

        stage('Test') {
            steps {
                inGo('go vet ./...')
                inGo('go test ./...')
                inGo('go run golang.org/x/vuln/cmd/govulncheck@v1.8.0 ./...')
            }
        }

        stage('Build') {
            when {
                not { branch 'main' }
            }
            steps {
                sh "docker build -f .cloud/docker/Dockerfile --target plugin --tag ${ImageName}:latest --tag ${Tag} ."
            }
        }

        stage('Deploy') {
            when {
                branch 'main'
            }
            environment {
                // Bound only here so PR and branch builds never see the token.
                DOCKERHUB_CREDENTIALS = credentials('dockerhub')
            }
            steps {
                script {
                    // A released version is immutable: never overwrite its image
                    // (e.g. a direct push to main without a version bump).
                    if (sh(script: "git tag -l '${Version}' | grep -q .", returnStatus: true) == 0) {
                        echo "Release ${Version} already exists, skipping image push and release."
                        return
                    }

                    sh 'echo "$DOCKERHUB_CREDENTIALS_PSW" | docker login -u "$DOCKERHUB_CREDENTIALS_USR" --password-stdin'

                    // Reuse existing builder or create new one
                    sh "docker buildx create --name ${Builder} --use --bootstrap 2>/dev/null || docker buildx use ${Builder}"

                    // Build and push first (can be retried without side effects)
                    sh "docker buildx build -f .cloud/docker/Dockerfile --platform linux/amd64,linux/arm64 --target plugin --tag ${ImageName}:latest --tag ${Tag} --push ."

                    // Only create tag and release after successful push. --target
                    // pins the tag to the commit that was built, not main's tip.
                    sh "gh release create '${Version}' --target \"\$GIT_COMMIT\" --title 'Release ${Version}' --generate-notes --prerelease=\$(echo '${Version}' | grep -q 'alpha\\|beta' && echo true || echo false)"
                }
            }
        }
    }

    post {
        failure {
            echo "Build failed for ${env.Tag ?: 'unknown'}"
            // Drop a possibly broken builder; the next deploy recreates it.
            sh "docker buildx rm ${env.Builder ?: 'none'} || true"
        }
    }
}
